rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isAdmin(tournamentId) {
      return request.auth != null &&
        get(/databases/$(database)/documents/tournaments/$(tournamentId))
          .data.admin_uid == request.auth.uid;
    }

    match /tournament_slugs/{slug} {
      allow read: if true;
      allow write: if false;
    }

    match /tournaments/{tournamentId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /config/{doc} {
        allow read: if request.auth != null;
        allow write: if false;
      }

      match /teams/{teamId} {
        // isAdmin non dipende da resource.data → consente anche le query
        // (onSnapshot su tutta la collection) dalla dashboard admin.
        allow read: if isAdmin(tournamentId) || isOwner(resource.data.owner_uid);
        allow write: if false;
      }

      match /matches/{matchId} {
        allow read: if true;
        allow write: if false;
      }

      match /standings/{groupId} {
        allow read: if true;
        allow write: if false;
      }
    }
  }
}
